      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parkimi-prometheus"
          },
          "expr": "100 * increase(parkimi_reservation_requests_total{job=\"parkimi-backend\",outcome=\"ok\"}[24h]) / clamp_min(increase(parkimi_reservation_requests_total{job=\"parkimi-backend\"}[24h]), 1)",
