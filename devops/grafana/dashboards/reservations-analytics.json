{
  "uid": "reservations-analytics",
  "title": "Reservations Analytics",
  "description": "Analitika e rezervimeve online (sektorët B/C): niveli aktual, suksesi kundrejt dështimeve dhe trendi në kohë. Pa të dhëna personale — vetëm numërues.",
  "tags": [
    "parkimi",
    "reservations"
  ],
  "style": "light",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 47,
      "type": "stat",
      "title": "Rezervime aktive",
      "description": "Rezervime në fuqi tani (B + C)",
      "datasource": {
        "type": "prometheus",
        "uid": "parkimi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parkimi-prometheus"
          },
          "expr": "sum(parkimi_reservations_active{job=\"parkimi-backend\"})",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 999999
              },
              {
                "color": "red",
                "value": 9999999
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
