{
  "uid": "api-performance",
  "title": "API Performance",
  "description": "Performanca e REST API-së: trafiku, kodet e statusit, vonesat (histogram p50/p95) dhe gabimet e serverit.",
  "tags": [
    "parkimi",
    "api",
    "performance"
  ],
  "style": "light",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 54,
      "type": "stat",
      "title": "Kërkesa / sekondë (5m)",
      "description": "Trafiku total i API-së",
      "datasource": {
        "type": "prometheus",
        "uid": "parkimi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parkimi-prometheus"
          },
          "expr": "sum(rate(parkimi_http_requests_total{job=\"parkimi-backend\"}[5m]))",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 999999
              },
              {
                "color": "red",
                "value": 9999999
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
