    {
      "id": 74,
      "type": "timeseries",
      "title": "Hyrjet: sukses kundrejt dështimeve (1h)",
      "description": "increase 1h — rritje e papritur e dështimeve = tentativë brute-force (kufiri: 10/15min për IP)",
      "datasource": {
        "type": "prometheus",
        "uid": "parkimi-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "parkimi-prometheus"
          },
          "expr": "increase(parkimi_audit_events_total{job=\"parkimi-backend\",action=~\"login|login_failed\"}[1h])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 14,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "pointSize": 4,
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "login"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "login_failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
