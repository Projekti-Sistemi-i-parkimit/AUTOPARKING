# ============================================================================
# Parkimi Inteligjent — shablloni i konfigurimit
#
# Kopjo këtë skedar si ".env" NË RRËNJË të repo-s dhe vendos vlerat reale:
#     cp .env.example .env
#
# KUJDES: .env NUK futet kurrë në Git (është në .gitignore).
#
# Ky është burimi i VETËM i konfigurimit për zhvillim lokal — e lexojnë
# si backend-i (process.loadEnvFile) ashtu edhe Docker Compose.
# Në Render NUK përdoret ky skedar: variablat vendosen te
# Render → Service → Environment (shih README, seksioni "Deployment në Render").
# ============================================================================

# --- Serveri -----------------------------------------------------------------
# Porta e backend-it (lokalisht dhe porta e hostit në Docker)
PORT=3000

# Rruga e databazës SQLite (vetëm pa Docker; në Docker është gjithmonë
# /data/parking.db në volumin parking_data dhe kjo vlerë injorohet)
# DB_PATH=./data/parking.db

# --- Administratori ----------------------------------------------------------
# Admini BOOTSTRAP: kredencialet lexohen nga environment-i; databaza mban
# vetëm identitetin. ADMIN_PASSWORD është E DETYRUESHME (min. 8 karaktere;
# vlerat placeholder si "changeme" refuzohen dhe autentikimi çaktivizohet).
# Adminët e ekipit (emir, erblin, isra, erdi, loresa, blendi) krijohen me
# "npm run seed:admins" dhe ruhen në databazë si hash scrypt — mos e vendos
# ADMIN_USERNAME me emrin e njërit prej tyre.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Ura e Arduino-s (Sektori A) ---------------------------------------------
# Çelësi API i urës. Nëse lihet bosh, gjenerohet një çelës i ri në nisjen e
# parë dhe shfaqet VETËM një herë në logje (docker compose logs backend).
# Në databazë ruhet vetëm hash-i i tij.
BRIDGE_API_KEY=

# --- Sesionet ----------------------------------------------------------------
# Kohëzgjatja e sesionit të adminit në orë
SESSION_TTL_HOURS=12

# --- QR / URL publike ---------------------------------------------------------
# URL-ja publike e faqes në prodhim (p.sh. https://autoparkoje.onrender.com),
# e përdorur në kodet QR. Lëre bosh në zhvillim lokal.
PUBLIC_BASE_URL=

# --- Sensorët (Sektori A — prototipi Arduino) ---------------------------------
# Pragjet e klasifikimit të distancës: ≤ OCC_THRESHOLD_CM = e zënë,
# ≤ MAX_RANGE_CM = e lirë. Pas SENSOR_OFFLINE_S sekondash heshtjeje → OFFLINE.
OCC_THRESHOLD_CM=3
MAX_RANGE_CM=10
SENSOR_OFFLINE_S=45

# --- Monitorimi lokal (opsional: docker compose --profile monitoring up -d) ---
# Kredencialet e Grafana-s (vetëm lokalisht, 127.0.0.1; nuk deployohen në Render)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
